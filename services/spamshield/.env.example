# SpamShield Configuration
NODE_ENV=development
PORT=3001

# Database (PostgreSQL - shared with SpamCapture)
DATABASE_URL=postgresql://user:password@localhost:5432/spamcapture
# Or individual components:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spamcapture
DB_USER=spamshield
DB_PASSWORD=your_secure_password

# Redis (for caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Security
API_KEY_HEADER=x-api-key
ADMIN_API_KEY=your_admin_api_key_here
JWT_SECRET=your_jwt_secret_here_min_32_chars

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Risk Scoring Configuration
RISK_THRESHOLD_LOW=30
RISK_THRESHOLD_MEDIUM=60
RISK_THRESHOLD_HIGH=85
RISK_THRESHOLD_BLOCK=90

# Sensitivity Levels (for freemium tiers)
BASIC_SENSITIVITY=medium
PREMIUM_SENSITIVITY=high

# Intelligence Refresh
INTELLIGENCE_REFRESH_INTERVAL=*/5 * * * *
CACHE_TTL_SECONDS=300

# Freemium Features
ENABLE_PREMIUM_FEATURES=false
ENABLE_ADVANCED_ANALYTICS=false

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Dashboard
DASHBOARD_ENABLED=true
DASHBOARD_AUTH_REQUIRED=true