# AgentSocial Cloud — Environment Template
# Copy to .env.<client_name> and fill in values
# This file is used by docker-compose.cloud.yml

# ─── Client Identity ───────────────────────────────────────────
CLIENT_DOMAIN=pleij.clawstudio.co
CLIENT_NAME=pleij

# ─── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_USER=agentsocial
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=agentsocial

# ─── Redis ──────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password_here

# ─── JWT Auth ───────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_random_64_char_secret_here

# ─── Square Billing ─────────────────────────────────────────────
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox

# ─── OpenAI (content generation + Dograh LLM) ──────────────────
OPENAI_API_KEY=

# ─── Composio (social media OAuth) ─────────────────────────────
COMPOSIO_API_KEY=

# ─── Adobe Express SDK ─────────────────────────────────────────
ADOBE_CLIENT_ID=2cfb2e097e5a4e97b7b09bffdcdc5a79

# ─── Dograh Voice Agent ────────────────────────────────────────
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── MinIO (voice audio storage) ──────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_here

# ─── Monitoring ────────────────────────────────────────────────
ALERT_EMAIL=

# ─── App Context (for Docker builds) ──────────────────────────
APP_CONTEXT=/opt/agentsocial