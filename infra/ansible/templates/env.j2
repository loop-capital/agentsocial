# AgentSocial Cloud — .env for Ansible Jinja2 template
# This template is used by provision.yml when no custom .env file is provided

CLIENT_DOMAIN={{ client_domain }}
CLIENT_NAME={{ client_name }}

POSTGRES_USER=agentsocial
POSTGRES_PASSWORD={{ lookup('password', '/dev/null length=32 chars=ascii_letters,digits') }}
POSTGRES_DB=agentsocial

REDIS_PASSWORD={{ lookup('password', '/dev/null length=32 chars=ascii_letters,digits') }}
JWT_SECRET={{ lookup('password', '/dev/null length=64 chars=ascii_letters,digits') }}

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY={{ lookup('password', '/dev/null length=32 chars=ascii_letters,digits') }}

APP_CONTEXT=/opt/agentsocial