# AgentSocial Voice Agent - Environment Config
# Copy this to .env and fill in your values

# === Telephony (Twilio) ===
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# === LLM Provider ===
OPENAI_API_KEY=your_openai_api_key
# Or use Anthropic:
# ANTHROPIC_API_KEY=your_anthropic_api_key

# === Speech-to-Text ===
DEEPGRAM_API_KEY=your_deepgram_api_key

# === Text-to-Speech ===
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# === AgentSocial Backend ===
AGENTSOCIAL_API_URL=http://localhost:3001/api/v1
AGENTSOCIAL_API_KEY=your_agentsocial_api_key

# === Dograh Platform ===
ENVIRONMENT=local
BACKEND_API_ENDPOINT=http://localhost:8000
ENABLE_TELEMETRY=false
OSS_JWT_SECRET=ChangeMeInProduction

# === Salon Config ===
SALON_NAME=PLEIJ Salon
SALON_PHONE=+1XXXXXXXXXX
SALON_ADDRESS=4170 N High St, Columbus, OH 43214
SALON_HOURS=Tuesday-Saturday 10am-7pm, Closed Sunday-Monday