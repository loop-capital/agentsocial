# AgentSocial Environment Variables
# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentsocial

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-here!!
JWT_EXPIRY=7d

# Token Encryption (AES-256-GCM key — generate with: openssl rand -hex 32)
TOKEN_ENCRYPTION_KEY=your-32-char-minimum-token-encryption-key!!

# Platform OAuth (Twitter/X)
# Apply at: https://developer.twitter.com/apps
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret

# Platform OAuth (LinkedIn)
# Apply at: https://www.linkedin.com/developers
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# Platform OAuth (Instagram via Facebook)
# Apply at: https://developers.facebook.com/apps
INSTAGRAM_CLIENT_ID=your-facebook-app-client-id
INSTAGRAM_CLIENT_SECRET=your-facebook-app-client-secret

# OpenAI (for AI features)
OPENAI_API_KEY=sk-your-openai-api-key

# Cloudinary (generated image/video asset CDN)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini (for multimodal AI — text, image, video generation)
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Cloudflare R2 / S3
S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key
S3_BUCKET=agentsocial-media

# App URLs (CRITICAL for OAuth — must match platform app settings)
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# ─── OAuth Callback URLs (register these in platform developer consoles) ───
# Twitter:   http://localhost:3001/channels/callback/twitter
# LinkedIn:  http://localhost:3001/channels/callback/linkedin
# Instagram: http://localhost:3001/channels/callback/instagram

NODE_ENV=development
LOG_LEVEL=debug
PORT=3001
HOST=0.0.0.0

# ─── CRM Integration ───────────────────────────────────────────────────────
# GoHighLevel OAuth (Phase 1B)
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=https://app.agentsocial.com/api/crm/providers/gohighlevel/oauth/callback

# Square OAuth (Phase 1C)
SQUARE_CLIENT_ID=
SQUARE_CLIENT_SECRET=
SQUARE_REDIRECT_URI=https://app.agentsocial.com/api/crm/providers/square/oauth/callback
SQUARE_ENVIRONMENT=production  # or sandbox

# 32-byte hex key used to encrypt CRM tokens (generate: openssl rand -hex 32)
TOKEN_ENCRYPTION_KEY=your-3…ey!!

# Public webhook base URL for CRM platforms to send events
WEBHOOK_BASE_URL=https://api.agentsocial.com/api/webhooks/crm

# ─── RunPod (LTX Video + ID-LoRA for avatar generation) ───────────────────────
# Get API key at: https://www.runpod.ai/
RUNPOD_API_KEY=
RUNPOD_LTX_ENDPOINT=
